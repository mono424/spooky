---
type Variant = 'note' | 'warning' | 'experimental';

interface Props {
  variant?: Variant;
  title?: string;
}

const { variant = 'note', title } = Astro.props;

const variants: Record<
  Variant,
  { label: string; shell: string; icon: string; heading: string; body: string; path: string }
> = {
  note: {
    label: 'Note',
    shell: 'border-white/[0.08] bg-white/[0.03]',
    icon: 'text-zinc-400',
    heading: 'text-zinc-100',
    body: 'text-zinc-400',
    path: 'M12 2.25c-4.97 0-9 3.654-9 8.25v6.592c0 1.135.834 2.1 1.956 2.262 1.296.186 2.458-.876 2.458-2.074 0 .736 1.011 1.258 1.968 1.455 1.295.267 2.618-.846 2.618-2.148 0 .808 1.054 1.465 2.112 1.625 1.306.196 2.508-.85 2.508-2.062 0 .764 1.06 1.304 2.058 1.448 1.3.188 2.32-.98 2.32-2.164V10.5c0-4.596-4.03-8.25-9-8.25Zm-3.75 7.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm7.5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z',
  },
  warning: {
    label: 'Warning',
    shell: 'border-amber-500/20 bg-amber-500/[0.07]',
    icon: 'text-amber-500',
    heading: 'text-amber-500',
    body: 'text-amber-200/70',
    path: 'M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z',
  },
  experimental: {
    label: 'Experimental',
    shell: 'border-amber-400/20 bg-amber-400/[0.07]',
    icon: 'text-amber-300',
    heading: 'text-amber-300',
    body: 'text-amber-200/70',
    path: 'M10 2a.75.75 0 0 0 0 1.5h.5V8.13a.75.75 0 0 0-.18.49l-4.5 8.25A2.25 2.25 0 0 0 7.787 20h8.426a2.25 2.25 0 0 0 1.968-3.13l-4.5-8.25a.75.75 0 0 0-.181-.49V3.5h.5a.75.75 0 0 0 0-1.5h-4Zm1.25 1.5h1.5V8.5a.75.75 0 0 0 .13.42L15.93 15H8.07l3.05-6.08a.75.75 0 0 0 .13-.42V3.5Z',
  },
};

const v = variants[variant];
const heading = title ?? v.label;
---

<div
  class:list={[
    'relative overflow-hidden rounded-glass border p-4 my-6 flex items-start gap-3 shadow-glass-inset',
    v.shell,
  ]}
>
  <div class:list={['shrink-0 mt-0.5', v.icon]}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
      <path fill-rule="evenodd" d={v.path} clip-rule="evenodd"></path>
    </svg>
  </div>

  <div
    class:list={[
      'text-sm leading-relaxed [&>p]:my-2 [&>:first-child]:mt-0 [&>:last-child]:mb-0',
      v.body,
    ]}
  >
    <strong class:list={['block mb-1 text-sm font-medium', v.heading]}>{heading}</strong>
    <slot />
  </div>
</div>
