---
import { docsNav } from '../../config/nav';

/**
 * Previous/next footer derived from docsNav reading order, so it can never
 * drift from the sidebar. Renders nothing for pages absent from the nav.
 */
const flat = docsNav.flatMap((group) => group.links.map((link) => ({ ...link, group: group.title })));

const clean = (path: string) => path.replace(/\/+$/, '') || '/';
const current = clean(Astro.url.pathname);

const index = flat.findIndex((link) => clean(link.href) === current);
const prev = index > 0 ? flat[index - 1] : null;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null;
---

{
  (prev || next) && (
    <nav
      class="not-prose mt-16 grid gap-3 border-t border-white/[0.08] pt-8 sm:grid-cols-2"
      aria-label="Page navigation"
    >
      {prev && (
        <a
          href={prev.href}
          rel="prev"
          class="group flex items-center gap-3 rounded-glass border border-white/[0.08] bg-white/[0.03] p-4 no-underline shadow-glass-inset transition-colors duration-200 hover:border-brand-400/30 hover:bg-white/[0.06]"
        >
          <svg
            class="h-4 w-4 shrink-0 text-text-muted transition-all duration-200 group-hover:-translate-x-0.5 group-hover:text-brand-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 12H5M11 18l-6-6 6-6" />
          </svg>
          <span class="min-w-0">
            <span class="block text-[11px] font-medium uppercase tracking-wider text-text-muted">
              Previous
            </span>
            <span class="block truncate text-sm font-medium text-text-primary">{prev.text}</span>
          </span>
        </a>
      )}
      {next && (
        <a
          href={next.href}
          rel="next"
          class:list={[
            'group flex items-center justify-end gap-3 rounded-glass border border-white/[0.08] bg-white/[0.03] p-4 text-right no-underline shadow-glass-inset transition-colors duration-200 hover:border-brand-400/30 hover:bg-white/[0.06]',
            !prev && 'sm:col-start-2',
          ]}
        >
          <span class="min-w-0">
            <span class="block text-[11px] font-medium uppercase tracking-wider text-text-muted">
              Next
            </span>
            <span class="block truncate text-sm font-medium text-text-primary">{next.text}</span>
          </span>
          <svg
            class="h-4 w-4 shrink-0 text-text-muted transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-brand-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      )}
    </nav>
  )
}
