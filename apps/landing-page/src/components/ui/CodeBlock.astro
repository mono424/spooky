---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
  fileName?: string;
}

const { code, lang = 'bash', fileName } = Astro.props;

---

<div
  class="code-block-wrapper glass-panel my-6 bg-[#0c0c0e]/80 shadow-glass overflow-hidden group max-w-full"
>
  <div class="relative">
    {/* Filename as a plain label — no window frame, no divider */}
    {
      fileName && (
        <span class="absolute top-3.5 left-4 font-mono text-xs text-text-muted select-none">
          {fileName}
        </span>
      )
    }

    {/* Copy Button */}
    <button
      class="copy-btn absolute top-3 right-3 p-2 rounded-lg bg-white/[0.06] border border-white/10 text-text-muted opacity-0 group-hover:opacity-100 transition-all duration-200 hover:bg-white/[0.12] hover:text-text-primary focus:opacity-100 focus:outline-none focus:ring-2 focus:ring-brand-500/50 backdrop-blur-md z-10"
      aria-label="Copy to clipboard"
      data-code={code}
    >
      <svg class="copy-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
        ></path>
      </svg>
      <svg
        class="check-icon w-4 h-4 hidden text-green-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"
        ></path>
      </svg>
    </button>

    {/* The Actual Code */}
    <div
      class:list={[
        'code-content px-4 pb-4 text-sm font-mono leading-relaxed overflow-x-auto custom-scrollbar',
        fileName ? 'pt-11' : 'pt-4',
      ]}
    >
      {
        /* The wrapper owns the background, so Shiki is made transparent in the
           global styles below. */
      }
      <Code
        code={code}
        lang={lang as any}
        themes={{ light: 'github-light', dark: 'github-dark' }}
        defaultColor={false}
      />
    </div>
  </div>
</div>

<script>
  const copyButtons = document.querySelectorAll('.copy-btn');

  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      const copyIcon = btn.querySelector('.copy-icon');
      const checkIcon = btn.querySelector('.check-icon');

      if (!code || !copyIcon || !checkIcon) return;

      try {
        await navigator.clipboard.writeText(code);
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      } catch {
        // Copy failed silently
      }
    });
  });
</script>

<style is:global>
  /* Important: We only override the background-color here.
     We removed the 'color' override so the syntax highlighting shows through.
  */
  /* No white-space: pre here — the wrapper's own newlines around <Code> would
     render as blank lines. The inner <pre> already preserves indentation. */

  /* Scoped to .code-content so it beats the plain-fence glass surface that
     docs.css puts on a bare .astro-code — here the wrapper supplies the frame. */
  .code-content .astro-code {
    background-color: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    /* .code-content supplies the padding; drop the prose <pre> box entirely */
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: auto !important; /* Scroll horizontally on narrow screens */
    white-space: pre !important; /* Preserve indentation and whitespace */
  }

  .astro-code code {
    white-space: pre !important; /* Preserve indentation and whitespace in code elements */
  }

  .astro-code pre {
    white-space: pre !important; /* Preserve indentation and whitespace in pre elements */
    margin: 0 !important;
    padding: 0 !important;
  }

  .astro-code span {
    white-space: pre !important; /* Preserve whitespace in syntax highlighted spans */
  }

  /* Custom Scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    height: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }
</style>
