---
/**
 * Icon.astro - A wrapper for Lucide icons.
 * Mapping the existing "semantic" names to specific Lucide icons.
 */
import {
  Wrench, // tool
  BrainCircuit, // brain
  Sparkles, // magic
  Building2, // building
  KeyRound, // key
  Route, // route
  RefreshCw, // sync
  BookOpen, // book
  PenLine, // pen
  Lock, // lock
  Box, // box
  Zap, // wave
  TriangleAlert, // warning
  Save, // save
  Bot, // bot
  Rocket, // rocket
  Database, // database
  Terminal, // terminal
  Cloud, // cloud
  Server, // server
  Clock, // clock
  Workflow, // workflow
  ListChecks, // jobs
  Layers, // layers
  Link2, // relationship
  FileCode2, // types
  GitBranch, // migrations
  Radio, // live
  WifiOff, // offline
  Flag, // flag
  FolderUp, // bucket
  Users, // users
  Gauge, // gauge
  Stethoscope, // doctor
  Settings2, // config
  ScrollText, // logs
  Smartphone, // mobile
  Code2, // code
  Play, // play
  ShieldCheck, // shield
  Puzzle, // puzzle
  HardDriveDownload, // backup
} from 'lucide-react';

// `strokeWidth` defaults to 1 to keep the large marketing icons hairline-thin;
// small inline icons (docs link cards) pass a heavier weight so they stay legible.
const { name, class: className, strokeWidth = 1 } = Astro.props;

// Map our custom names to Lucide components
const iconMap = {
  tool: Wrench,
  brain: BrainCircuit,
  magic: Sparkles,
  building: Building2,
  key: KeyRound,
  route: Route,
  sync: RefreshCw,
  book: BookOpen,
  pen: PenLine,
  lock: Lock,
  box: Box,
  wave: Zap,
  warning: TriangleAlert,
  save: Save,
  bot: Bot,
  rocket: Rocket,
  database: Database,
  terminal: Terminal,
  cloud: Cloud,
  server: Server,
  clock: Clock,
  workflow: Workflow,
  jobs: ListChecks,
  layers: Layers,
  relationship: Link2,
  types: FileCode2,
  migrations: GitBranch,
  live: Radio,
  offline: WifiOff,
  flag: Flag,
  bucket: FolderUp,
  users: Users,
  gauge: Gauge,
  doctor: Stethoscope,
  config: Settings2,
  logs: ScrollText,
  mobile: Smartphone,
  code: Code2,
  play: Play,
  shield: ShieldCheck,
  puzzle: Puzzle,
  backup: HardDriveDownload,
};

const LucideIcon = iconMap[name] || Wrench;
---

<LucideIcon className={className} strokeWidth={strokeWidth} />
