# yaml-language-server: $schema=https://sp00ky.cloud/schema/sp00ky.schema.json
mode: singlenode # "singlenode", "cluster", or "surrealism"
schema: {{SCHEMA_DIR}}
buckets: []{{CLIENT_TYPES_SECTION}}

# --- Optional configuration (uncomment as needed) ---
#
# slug: my-project                # Sp00ky Cloud project identifier
# cloudApi: https://api.sp00ky.cloud   # override Cloud API endpoint
#
# surrealdb:
#   namespace: main
#   database: main
#   # hosting defaults to "cloud" (Sp00ky manages the DB + root password).
#   # endpoint/username/password are ONLY valid with hosting: external.
#   # --- Bring-your-own external DB ---
#   # hosting: external
#   # endpoint: "https://my-surreal.example.com"   # required for external
#   # Each credential is a literal OR a { vault: KEY } reference resolved from
#   # the encrypted vault at deploy time (mix freely, like env: below).
#   # username: root
#   # password: { vault: DB_PASSWORD }
#
# version:                        # service versions per environment
#   dev: dev
#   cloud: canary
#
# logLevel:                       # RUST_LOG directive per environment
#   dev: trace
#   cloud: info
#
# migrationEngine: legacy         # "legacy" (default) or "surrealkit"
